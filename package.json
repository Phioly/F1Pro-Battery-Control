{
  "name": "f1pro-ec-control",
  "version": "0.6.13",
  "description": "OneXFly F1 Pro (HX 370) charge mode, bypass charging, charge limit and fan control for Decky Loader on SteamOS.",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phioly/F1Pro-EC-Control.git"
  },
  "homepage": "https://github.com/Phioly/F1Pro-EC-Control",
  "bugs": {
    "url": "https://github.com/Phioly/F1Pro-EC-Control/issues"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs display",
    "test:backend": "node scripts/run-tests.mjs backend",
    "test:all": "node scripts/run-tests.mjs all"
  },
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
